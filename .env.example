# netbox-mcp-server environment variables.
#
# Copy to `.env` and fill in your values, or set them in your MCP client config
# (Claude Desktop, Claude Code, Cursor, Codex). `.env` is gitignored — never
# commit a token.
#
# These three are the complete set. There is no server-side read-only switch
# and no tool grouping: NETBOX_READONLY and NETBOX_TOOL_GROUPS were removed in
# 0.1.0, and setting them now does nothing.

# ---- Required ---------------------------------------------------------------

# Base URL of your NetBox instance. Do NOT include /api — the server adds it.
NETBOX_URL=https://netbox.example.com

# API token. Create one in NetBox under your user menu > API Tokens > Add.
#
# The token is the ONLY write control. Leave "Write enabled" UNCHECKED unless
# the assistant genuinely needs to change records, and constrain the token's
# object permissions to what it should see. NetBox enforces both, where no tool
# argument can reach them — which is why this server does not offer a switch of
# its own. Deletes cascade in NetBox and cannot be undone.
NETBOX_TOKEN=your-api-token-here

# ---- Optional ---------------------------------------------------------------

# Set to 1 to skip TLS certificate verification. Common for on-prem NetBox
# behind an internal CA — but it disables certificate validation entirely and
# exposes the token to anyone able to intercept the connection. Prefer
# installing the corporate root CA into the system trust store.
# NETBOX_INSECURE=0
