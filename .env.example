# netbox-mcp-server environment variables.
#
# Copy to `.env` and fill in your values, or set them in your MCP client config
# (Claude Desktop, Codex, Cursor). `.env` is gitignored — never commit a token.

# ---- Required ---------------------------------------------------------------

# Base URL of your NetBox instance. Do NOT include /api — the server adds it.
NETBOX_URL=https://netbox.example.com

# API token. Create one in NetBox under your user menu > API Tokens > Add.
# Tick "Read-only" on the token unless you need to modify NetBox records.
NETBOX_TOKEN=your-api-token-here

# ---- Optional ---------------------------------------------------------------

# Set to 1 to skip TLS certificate verification. Common for on-prem NetBox
# behind an internal CA. Prefer installing the corporate root CA instead —
# this disables certificate validation entirely.
# NETBOX_INSECURE=0

# Set to 1 to register ONLY the read tools (list / get / global search, 179
# total). Create, update, and delete tools are not registered at all, so the
# model cannot call them. Recommended for most users.
# NETBOX_READONLY=1

# Comma-separated allowlist of tool groups. Unset = all groups (446 tools).
# Valid: search, dcim, dcim_org, dcim_components, ipam, ipam_org,
#        ipam_services, inventory, power, tenancy, virtualization, circuits,
#        deletes
# Anything not named is omitted — including deletes.
# NETBOX_TOOL_GROUPS=search,dcim,ipam,tenancy
